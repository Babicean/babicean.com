# Security headers for every response (Cloudflare Workers static assets).
# No inline scripts or styles anywhere, so the CSP needs no 'unsafe-inline'.
# The only third party is Cloudflare Web Analytics (cookie-less), which
# Cloudflare injects at the edge: its script host and beacon endpoint are allowed.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://cloudflareinsights.com; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

# Hashed build assets never change, so browsers can keep them for a year.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
