---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectShowcase from '../components/ProjectShowcase.astro';
import { site } from '../site';
import { meta } from '../lib/meta';

// Drafts never reach the homepage; `order` decides the sequence.
const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);

const reading = (await getCollection('reading', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);

// Fixed three-letter months: en-AU's own short form gives "Sept".
const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const published = (year: number, month?: number) =>
  month ? `${MONTHS[month - 1]} ${year}` : String(year);
const pad = (n: number) => String(n).padStart(2, '0');
---

<Base home>
  <section class="hero" aria-labelledby="intro">
    <p class="eyebrow">
      <span class="status-dot" aria-hidden="true"></span>{meta(['Student developer', 'Brisbane', 'AU'])}
    </p>
    <h1 id="intro">Useful software.<br /><span>Safer systems.</span></h1>
    <p class="hero-description">
      I’m Brendon, an IT student at QUT studying <strong>Cybersecurity and Artificial Intelligence.</strong>{' '}
      I build mobile apps and explore the security challenges of a world with more AI.
    </p>
    <div class="hero-actions">
      <a class="button" href="#work">Explore my work <span aria-hidden="true">↓</span></a>
      <a class="text-link" href={`mailto:${site.email}`}>Get in touch <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section id="work" class="section" aria-labelledby="work-label">
    <h2 id="work-label" class="section-label"><span>01</span> Work</h2>
    {projects.map((project, i) => <ProjectShowcase project={project} priority={i === 0} />)}
  </section>

  <section id="about" class="section" aria-labelledby="about-label">
    <h2 id="about-label" class="section-label"><span>02</span> About</h2>
    <div class="about-layout">
      <div class="prose">
        <p>
          I’m interested in where cybersecurity and AI meet: the security challenges that arise as AI
          becomes more accessible and widely used, and how to build systems that stay secure as it does.
        </p>
        <p>Whilst I study, I drive Uber around 45 hours a week and build personal iOS and Android apps.</p>
        <a class="text-link" href={site.links.linkedin} rel="me noopener">
          More about me on LinkedIn <span class="ext" aria-hidden="true">↗</span>
        </a>
      </div>
      <dl class="background-list">
        <div>
          <dt class="eyebrow">Studying</dt>
          <dd>
            <strong>{site.studying.degree}</strong>
            <span>{site.studying.school}</span>
            <span class="detail-note">{site.studying.detail}</span>
          </dd>
        </div>
        <div>
          <dt class="eyebrow">Building with</dt>
          <dd><strong>{meta(site.building)}</strong></dd>
        </div>
        <div>
          <dt class="eyebrow">Based in</dt>
          <dd><strong>{meta(site.location)}</strong></dd>
        </div>
      </dl>
    </div>
  </section>

  {
    reading.length > 0 && (
      <section id="reading" class="section" aria-labelledby="reading-label">
        <div class="section-head">
          <h2 id="reading-label" class="section-label">
            <span>03</span> Reading
          </h2>
          <p class="section-intro">A few things shaping how I think about AI and security.</p>
        </div>
        <ol class="reading-list">
          {reading.map((item, i) => (
            <li class="reading-item">
              <span class="reading-number" aria-hidden="true">
                {pad(i + 1)}
              </span>
              <div>
                <p class="eyebrow">{meta([item.data.author, published(item.data.year, item.data.month)])}</p>
                <h3>
                  <a href={item.data.url} rel="noopener">
                    {item.data.title} <span aria-hidden="true">↗</span>
                  </a>
                </h3>
                <p>{item.data.summary}</p>
              </div>
            </li>
          ))}
        </ol>
      </section>
    )
  }

  <section id="contact" class="section" aria-labelledby="contact-label">
    <h2 id="contact-label" class="section-label"><span>04</span> Contact</h2>
    <div class="contact-layout">
      <div>
        <p class="contact-intro">
          Have an opportunity, a question or something interesting to share? I’d like to hear from you.
        </p>
        <div class="email-actions">
          <a class="email-link" href={`mailto:${site.email}`}>{site.email}</a>
          <button class="copy-email" type="button" data-copy={site.email} aria-label="Copy email address" hidden>
            <svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true">
              <rect x="7" y="7" width="10" height="10" rx="2"></rect>
              <path d="M12 7V4a1 1 0 0 0-1-1H4a1 1 0 0 0-1 1v7a1 1 0 0 0 1 1h3"></path>
            </svg>
          </button>
          <span class="copy-status" role="status" aria-live="polite"></span>
        </div>
      </div>
      <ul class="social-links">
        <li><a href={site.links.github} rel="me noopener">GitHub <span aria-hidden="true">↗</span></a></li>
        <li><a href={site.links.linkedin} rel="me noopener">LinkedIn <span aria-hidden="true">↗</span></a></li>
      </ul>
    </div>
  </section>
</Base>

<script>
  // Copy-email button: only shown when the clipboard is available.
  const button = document.querySelector<HTMLButtonElement>('[data-copy]');
  const status = document.querySelector<HTMLElement>('.copy-status');

  if (button && status && navigator.clipboard) {
    let clear = 0;
    button.hidden = false;
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? '');
        status.textContent = 'Email copied';
      } catch {
        status.textContent = 'Couldn’t copy. Long-press the address instead.';
      }
      window.clearTimeout(clear);
      clear = window.setTimeout(() => (status.textContent = ''), 4000);
    });
  }
</script>
