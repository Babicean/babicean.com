---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
import { site } from '../site';
import { meta } from '../lib/meta';

// Drafts never reach the homepage; order puts the newest work first.
const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Base>
  <header class="masthead">
    <h1>{site.name}</h1>
    <p class="tagline muted">{meta(site.tagline)}</p>
    <p class="location mono muted">{meta(site.location)}</p>
  </header>

  <section class="row" aria-labelledby="about">
    <h2 id="about">About</h2>
    <div class="row-body">
      <p>
        I study IT at QUT, double-majoring in Cybersecurity and AI. I'm particularly interested in
        the security ramifications of AI and how AI systems are kept secure themselves. Whilst I
        study, I'm a full-time Uber driver who likes to build and design personal iOS and Android
        apps.
      </p>
    </div>
  </section>

  <section class="row" id="projects" aria-labelledby="projects-label">
    <h2 id="projects-label">Projects</h2>
    <ul class="row-body project-list">
      {
        projects.map((project) => (
          <li>
            <a class="project" href={`/projects/${project.id}/`}>
              <span class="project-year mono muted">{project.data.year}</span>
              <span class="project-main">
                <span class="project-title">
                  {project.data.title} <span class="arrow" aria-hidden="true">→</span>
                </span>
                <span class="project-summary muted">{project.data.summary}</span>
              </span>
              {project.data.platforms.length > 0 && (
                <span class="project-meta mono muted">{meta(project.data.platforms)}</span>
              )}
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="row" aria-labelledby="studying">
    <h2 id="studying">Studying</h2>
    <div class="row-body study">
      <p>Bachelor of Information Technology</p>
      <p class="muted">
        {meta(['Queensland University of Technology', 'Double major in Cybersecurity and Artificial Intelligence'])}
      </p>
    </div>
  </section>

  <section class="row" aria-labelledby="elsewhere">
    <h2 id="elsewhere">Elsewhere</h2>
    <ul class="row-body link-list">
      {
        site.links.map((link) => (
          <li>
            <a href={link.href} rel="me noopener">
              <span>{link.label}</span>
              <span class="meta">{link.meta} ↗</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="row" id="contact" aria-labelledby="contact-label">
    <h2 id="contact-label">Contact</h2>
    <div class="row-body">
      <a class="email" href={`mailto:${site.email}`}>{site.email}</a>
    </div>
  </section>

  <Footer>
    <p>{site.quote}</p>
  </Footer>
</Base>

<style>
  .project-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .project-list > li + li {
    margin-top: var(--s-5);
  }

  /* The whole row is the tap target, but only the title reacts. */
  .project {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s-1) var(--s-5);
    text-decoration: none;
    color: var(--ink);
  }

  .project-year {
    flex: 0 0 48px;
    font-size: var(--t-meta);
  }

  .project-main {
    flex: 1 1 320px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
  }

  .project-title {
    font-size: var(--t-heading);
    font-weight: 500;
    line-height: 1.3;
    transition: color 120ms ease;
  }

  .project .arrow {
    display: inline-block;
    transition: transform 160ms ease;
  }

  .project:hover .arrow,
  .project:focus .arrow {
    transform: translateX(3px);
  }

  .project:hover .project-title {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
  }

  .project:focus .project-title,
  .project:active .project-title {
    color: var(--accent);
  }

  .project:focus-visible .project-title {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
  }

  .project-summary {
    font-size: var(--t-sub);
    line-height: 1.5;
  }

  .project-meta {
    font-size: var(--t-meta);
  }

  .study > p + p {
    margin-top: var(--s-1);
    font-size: var(--t-sub);
    line-height: 1.5;
  }

  .email {
    font-size: var(--t-title);
    font-weight: 500;
    line-height: 1.4;
    color: var(--accent);
    text-underline-offset: 6px;
    overflow-wrap: anywhere;
  }

  .email:hover,
  .email:focus {
    color: var(--accent);
    text-decoration-thickness: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .project .arrow,
    .project-title {
      transition: none;
    }
  }
</style>
