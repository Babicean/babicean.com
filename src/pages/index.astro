---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { site } from '../site';
import { meta } from '../lib/meta';

// Drafts never reach the homepage; order puts the newest work first.
const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);

const now = new Date();
const updated = new Intl.DateTimeFormat('en-AU', {
  month: 'short',
  year: 'numeric',
  timeZone: 'Australia/Brisbane',
}).format(now);
---

<Base>
  <header class="masthead">
    <div>
      <h1>{site.name}</h1>
      <p class="muted">{meta(site.tagline)}</p>
    </div>
    <p class="location mono muted">{meta(site.location)}</p>
  </header>

  <section class="row" aria-labelledby="about">
    <h2 id="about">About</h2>
    <div class="row-body">
      <p>
        I study IT at QUT, double-majoring in Cybersecurity and AI. I'm particularly drawn to AI,
        learning how it's used in security and how AI systems are kept secure themselves. Alongside
        study, I'm a full-time Uber driver and I build personal iOS and Android apps.
      </p>
    </div>
  </section>

  <section class="row" id="projects" aria-labelledby="projects-label">
    <h2 id="projects-label">Projects</h2>
    <ul class="row-body project-list">
      {
        projects.map((project) => (
          <li>
            <a class="project" href={`/projects/${project.id}/`}>
              <span class="project-year mono muted">{project.data.year}</span>
              <span class="project-main">
                <span class="project-title">
                  {project.data.title} <span class="arrow" aria-hidden="true">→</span>
                </span>
                <span class="project-summary muted">{project.data.summary}</span>
              </span>
              {project.data.platforms.length > 0 && (
                <span class="project-meta mono muted">{meta(project.data.platforms)}</span>
              )}
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="row" aria-labelledby="studying">
    <h2 id="studying">Studying</h2>
    <div class="row-body study">
      <p>Bachelor of Information Technology</p>
      <p class="muted">
        {meta(['Queensland University of Technology', 'Double major in Cybersecurity and Artificial Intelligence'])}
      </p>
    </div>
  </section>

  <section class="row row--links" aria-labelledby="elsewhere">
    <h2 id="elsewhere">Elsewhere</h2>
    <ul class="row-body link-list">
      {
        site.links.map((link) => (
          <li>
            <a href={link.href} rel="me noopener">
              <span>{link.label}</span>
              <span class="meta">{link.meta} ↗</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="row contact" id="contact" aria-labelledby="contact-label">
    <h2 id="contact-label">Contact</h2>
    <div class="row-body">
      <a class="email" href={`mailto:${site.email}`}>{site.email}</a>
    </div>
  </section>

  <footer class="site-footer">
    <span>© {now.getFullYear()} {site.name}</span>
    <span>Last updated {updated}</span>
  </footer>
</Base>

<style>
  .project-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .project-list > li + li {
    margin-top: 24px;
  }

  .project {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 24px;
    padding: 4px 0;
    text-decoration: none;
    color: var(--ink);
  }

  .project-year {
    flex: 0 0 48px;
    font-size: 13px;
  }

  .project-main {
    flex: 1 1 320px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .project-title {
    font-size: 22px;
    font-weight: 500;
    line-height: 1.3;
  }

  .project .arrow {
    display: inline-block;
    transition: transform 160ms ease;
  }

  .project:hover .arrow {
    transform: translateX(3px);
  }

  .project:hover .project-title {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
  }

  .project-summary {
    font-size: 16px;
    line-height: 1.5;
  }

  .project-meta {
    font-size: 13px;
  }

  .study > p + p {
    margin-top: 4px;
    font-size: 16px;
    line-height: 1.5;
  }

  .contact > h2 {
    padding-top: 10px;
  }

  .email {
    font-size: 28px;
    font-weight: 500;
    line-height: 1.4;
    color: var(--accent);
    text-underline-offset: 6px;
    overflow-wrap: anywhere;
  }

  .email:hover {
    color: var(--accent);
    text-decoration-thickness: 2px;
  }

  @media (max-width: 640px) {
    .email {
      font-size: 22px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project .arrow {
      transition: none;
    }
  }
</style>
