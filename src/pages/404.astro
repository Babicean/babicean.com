---
import Base from '../layouts/Base.astro';
---

<Base title="Not found" description="This page doesn't exist.">
  <section class="hero" aria-labelledby="not-found">
    <p class="eyebrow">404</p>
    <h1 id="not-found">Not found<span>.</span></h1>
    <p class="hero-description">This page doesn’t exist, or it has moved.</p>
    <div class="hero-actions">
      <a class="button" href="/">Back to the homepage <span aria-hidden="true">→</span></a>
    </div>
  </section>
</Base>
