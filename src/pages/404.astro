---
import Base from '../layouts/Base.astro';
---

<Base title="Not found" description="This page doesn't exist.">
  <header class="masthead">
    <div>
      <h1>Not found</h1>
      <p class="muted">This page doesn't exist, or it has moved.</p>
    </div>
    <p class="location mono muted">404</p>
  </header>

  <section class="row" aria-labelledby="next">
    <h2 id="next">Next</h2>
    <div class="row-body">
      <p><a href="/">Back to the index <span class="arrow" aria-hidden="true">→</span></a></p>
    </div>
  </section>
</Base>
