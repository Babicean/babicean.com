---
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
import { site } from '../site';
---

<Base title="Not found" description="This page doesn't exist.">
  <header class="masthead">
    <h1>Not found</h1>
    <p class="tagline muted">This page doesn't exist, or it has moved.</p>
    <p class="location mono muted">404</p>
  </header>

  <section class="row" aria-labelledby="next">
    <h2 id="next">Next</h2>
    <div class="row-body">
      <p><a href="/">Back to the index <span class="arrow" aria-hidden="true">→</span></a></p>
    </div>
  </section>

  <Footer>
    <p>{site.quote}</p>
  </Footer>
</Base>
