---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Footer from '../../components/Footer.astro';
import TallyScreen from '../../components/TallyScreen.astro';
import { site } from '../../site';
import { meta } from '../../lib/meta';

// One page per published project. Drafts get no page at all.
export const getStaticPaths = (async () => {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}) satisfies GetStaticPaths;

const { project } = Astro.props;
const { data } = project;
const { Content } = await render(project);

// Built-in visuals a project can ask for with `media:` in its frontmatter.
const mediaComponents = { 'tally-screen': TallyScreen };
const Media = data.media ? mediaComponents[data.media] : null;

const facts = [
  { label: 'Year', value: String(data.year) },
  { label: 'Role', value: data.role },
  { label: 'Stack', value: meta(data.stack) },
  { label: 'Status', value: data.status },
].filter((fact) => fact.value);
---

<Base title={data.title} description={data.summary}>
  <nav class="crumbs mono" aria-label="Breadcrumb">
    <a href="/">← {site.name}</a>
    <span class="muted">Projects / {data.title}</span>
  </nav>

  <header class="project-head">
    <h1>{data.title}</h1>
    <p class="muted">{data.tagline}</p>
  </header>

  <dl class="facts">
    {
      facts.map((fact) => (
        <div>
          <dt>{fact.label}</dt>
          <dd>{fact.value}</dd>
        </div>
      ))
    }
  </dl>

  {
    Media && (
      <section class="row row--media" aria-labelledby="screens">
        <h2 id="screens">Screens</h2>
        <div class="row-body">
          <figure class="stage">
            <Media />
            {data.mediaCaption && <figcaption class="mono muted">{data.mediaCaption}</figcaption>}
          </figure>
        </div>
      </section>
    )
  }

  <Content />

  {
    data.links.length > 0 && (
      <section class="row" aria-labelledby="links">
        <h2 id="links">Links</h2>
        <ul class="row-body link-list">
          {data.links.map((link) => (
            <li>
              <a href={link.href} rel="noopener">
                <span>{link.label}</span>
                <span class="arrow" aria-hidden="true">↗</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <Footer>
    <a href="/">← Back to index</a>
  </Footer>
</Base>

<style>
  /* Breadcrumbs sit in the top margin, so the title lines up with the
     homepage name. */
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0 var(--s-4);
    margin: calc(var(--s-7) * -1) 0 var(--s-6);
    font-size: 13px;
  }

  .crumbs a {
    padding-block: var(--s-3);
    margin-block: calc(var(--s-3) * -1);
    text-decoration: none;
  }

  .project-head {
    padding-bottom: var(--s-7);
    border-bottom: 1px solid var(--ink);
  }

  .project-head h1 {
    margin: 0;
    font-size: 44px;
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .project-head p {
    margin: var(--s-2) 0 0;
    max-width: 640px;
    font-size: 18px;
    line-height: 1.4;
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-5) var(--s-6);
    margin: 0;
    padding-block: var(--row-pad);
    border-bottom: 1px solid var(--rule);
  }

  /* Size each fact to its content so short metadata never wraps mid-list. */
  .facts > div {
    flex: 1 1 auto;
  }

  .facts dt {
    margin-bottom: var(--s-1);
    font: 500 12px/1.6 var(--mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-2);
  }

  .facts dd {
    margin: 0;
    font-size: 17px;
    white-space: nowrap;
  }

  .stage {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--s-3);
    padding: var(--s-7) var(--s-4);
    border-radius: 6px;
    background: var(--stage);
  }

  .stage figcaption {
    font-size: 12px;
  }

  @media (max-width: 640px) {
    .crumbs {
      margin-top: calc(var(--s-5) * -1);
    }

    .project-head {
      padding-bottom: var(--s-6);
    }

    .project-head h1 {
      font-size: 36px;
    }

    .stage {
      padding: var(--s-6) var(--s-2);
    }
  }

  @media (max-width: 400px) {
    .facts dd {
      white-space: normal;
    }
  }
</style>
