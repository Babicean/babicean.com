---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Footer from '../../components/Footer.astro';
import ScreenCarousel from '../../components/ScreenCarousel.astro';
import { site } from '../../site';
import { meta } from '../../lib/meta';

// One page per published project. Drafts get no page at all.
export const getStaticPaths = (async () => {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}) satisfies GetStaticPaths;

const { project } = Astro.props;
const { data } = project;
const { Content } = await render(project);

const facts = [
  { label: 'Year', value: String(data.year) },
  { label: 'Role', value: data.role },
  { label: 'Stack', value: meta(data.stack) },
  { label: 'Status', value: data.status },
].filter((fact) => fact.value);
---

<Base title={data.title} description={data.summary}>
  <header class="project-head">
    <nav class="crumbs mono" aria-label="Breadcrumb">
      <a class="back" href="/"><span class="back-arrow" aria-hidden="true">←</span> {site.name}</a>
      <span class="muted">Projects / {data.title}</span>
    </nav>
    <h1>{data.title}</h1>
    <p class="tagline muted">{data.tagline}</p>
  </header>

  <dl class="facts">
    {
      facts.map((fact) => (
        <div>
          <dt>{fact.label}</dt>
          <dd>{fact.value}</dd>
        </div>
      ))
    }
  </dl>

  {
    data.screens.length > 0 && (
      <section class="row row--media" aria-labelledby="screens">
        <h2 id="screens">Screens</h2>
        <div class="row-body">
          <ScreenCarousel screens={data.screens} frame={data.frame} label={`${data.title} screens`} />
        </div>
      </section>
    )
  }

  <Content />

  {
    data.links.length > 0 && (
      <section class="row" aria-labelledby="links">
        <h2 id="links">Links</h2>
        <ul class="row-body link-list">
          {data.links.map((link) => (
            <li>
              <a href={link.href} rel="noopener">
                <span>{link.label}</span>
                <span class="arrow" aria-hidden="true">↗</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <Footer>
    <a href="/">← Back to index</a>
  </Footer>
</Base>

<style>
  /* Header rhythm, measured from rendered text: breadcrumb to title is twice
     title to tagline, so the title and tagline read as one group. */
  .project-head {
    padding-bottom: var(--s-7);
    border-bottom: 1px solid var(--ink);
  }

  .crumbs {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0 var(--s-4);
    margin-bottom: var(--crumb-gap);
    font-size: var(--t-meta);
    line-height: 1.4;
  }

  .crumbs a {
    padding-block: var(--s-3);
    margin-block: calc(var(--s-3) * -1);
    text-decoration: none;
  }

  /* The mono arrow sits centred in a wide cell; pull it back to the left edge. */
  .back-arrow {
    margin-left: var(--arrow-pull);
  }

  .project-head h1 {
    margin: 0 0 0 var(--title-pull);
    font-size: var(--t-large);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .project-head .tagline {
    margin: var(--s-1) 0 0;
    max-width: 640px;
    font-size: var(--t-lead);
    line-height: 1.4;
  }

  .project-head {
    --crumb-gap: var(--s-5);
    --arrow-pull: 0px;
    --title-pull: 0px;
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-5) var(--s-6);
    margin: 0;
    padding-block: var(--row-pad);
    border-bottom: 1px solid var(--rule);
  }

  /* Size each fact to its content so short metadata never wraps mid-list. */
  .facts > div {
    flex: 1 1 auto;
  }

  .facts dt {
    margin-bottom: var(--s-1);
    font: 500 var(--t-label)/1.6 var(--mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-2);
  }

  /* Facts size to their content, so short metadata stays on one line when
     there's room and still wraps (rather than overflowing) when there isn't. */
  .facts dd {
    margin: 0;
    font-size: var(--t-body);
  }


  @media (max-width: 640px) {
    .project-head {
      padding-bottom: var(--s-6);
    }
  }

</style>
