---
/**
 * Site footer. The left side is whatever the page passes in (a quote on the
 * homepage, a back link on project pages). The right side is a tiny analogue
 * clock showing the time in Brisbane, ticking live.
 *
 * Without JavaScript the clock simply stays hidden.
 */
---

<footer class="site-footer">
  <div class="left"><slot /></div>
  <p class="clock" data-clock hidden>
    <svg class="clock-face" width="14" height="14" viewBox="0 0 28 28" aria-hidden="true">
      <circle class="clock-rim" cx="14" cy="14" r="12.5"></circle>
      <line class="clock-hour" x1="14" y1="14" x2="14" y2="8"></line>
      <line class="clock-minute" x1="14" y1="14" x2="14" y2="4.5"></line>
      <line class="clock-second" x1="14" y1="16.5" x2="14" y2="3.5"></line>
      <circle class="clock-pin" cx="14" cy="14" r="1.4"></circle>
    </svg>
    <time data-clock-time></time><span aria-hidden="true"> · </span>Brisbane
  </p>
</footer>

<script>
  const clock = document.querySelector<HTMLElement>('[data-clock]');

  if (clock) {
    const timeEl = clock.querySelector<HTMLTimeElement>('[data-clock-time]')!;
    const hour = clock.querySelector('.clock-hour')!;
    const minute = clock.querySelector('.clock-minute')!;
    const second = clock.querySelector('.clock-second')!;

    const zone = 'Australia/Brisbane';
    const label = new Intl.DateTimeFormat('en-AU', {
      timeZone: zone,
      hour: 'numeric',
      minute: '2-digit',
      hour12: true,
    });
    const parts = new Intl.DateTimeFormat('en-AU', {
      timeZone: zone,
      hour: 'numeric',
      minute: 'numeric',
      second: 'numeric',
      hourCycle: 'h23',
    });

    const tick = () => {
      const now = new Date();
      const get = (type: string) =>
        Number(parts.formatToParts(now).find((p) => p.type === type)?.value ?? 0);
      const h = get('hour') % 12;
      const m = get('minute');
      const s = get('second');

      hour.setAttribute('transform', `rotate(${(h + m / 60) * 30} 14 14)`);
      minute.setAttribute('transform', `rotate(${(m + s / 60) * 6} 14 14)`);
      second.setAttribute('transform', `rotate(${s * 6} 14 14)`);
      timeEl.textContent = label.format(now);
      timeEl.dateTime = now.toISOString();

      // Wake on the next whole second so the hand ticks in time with real clocks.
      window.setTimeout(tick, 1000 - (now.getTime() % 1000));
    };

    tick();
    clock.hidden = false;
  }
</script>

<style>
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--s-2) var(--s-5);
    padding-top: var(--row-pad);
    font: 400 var(--t-label)/1.6 var(--mono);
    color: var(--ink-2);
  }

  .left :global(p) {
    margin: 0;
  }

  /* Keeps a 44px tap target without changing the footer's height. */
  .left :global(a) {
    display: inline-block;
    padding-block: var(--s-3);
    margin-block: calc(var(--s-3) * -1);
    text-decoration: none;
  }

  /* Plain inline text, so its baseline lines up with the left side. The face
     sits on the text's x-height centre. */
  .clock {
    margin: 0;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .clock[hidden] {
    display: none;
  }

  .clock-face {
    margin-right: var(--s-2);
    vertical-align: -0.2em;
    overflow: visible;
    stroke-linecap: round;
  }

  .clock-rim {
    fill: none;
    stroke: var(--ink-2);
    stroke-width: 1.5;
  }

  .clock-hour {
    stroke: var(--ink);
    stroke-width: 2.4;
  }

  .clock-minute {
    stroke: var(--ink);
    stroke-width: 1.6;
  }

  .clock-second {
    stroke: var(--accent);
    stroke-width: 1;
  }

  .clock-pin {
    fill: var(--accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .clock-second {
      display: none;
    }
  }
</style>
