---
/**
 * Site footer: the quote on the left, a tiny analogue clock showing the time
 * in Brisbane on the right, ticking live. Without JavaScript the clock stays
 * hidden.
 */
import { site } from '../site';
---

<footer class="site-footer wrap">
  <p>{site.quote}</p>
  <p class="clock" data-clock hidden>
    <svg class="clock-face" width="16" height="16" viewBox="0 0 28 28" aria-hidden="true">
      <circle class="clock-rim" cx="14" cy="14" r="12.5"></circle>
      <line class="clock-hour" x1="14" y1="14" x2="14" y2="8"></line>
      <line class="clock-minute" x1="14" y1="14" x2="14" y2="4.5"></line>
      <line class="clock-second" x1="14" y1="16.5" x2="14" y2="3.5"></line>
      <circle class="clock-pin" cx="14" cy="14" r="1.4"></circle>
    </svg>
    <time data-clock-time></time><span aria-hidden="true">·</span><span>Brisbane</span>
  </p>
</footer>

<script>
  const clock = document.querySelector<HTMLElement>('[data-clock]');

  if (clock) {
    const timeEl = clock.querySelector<HTMLTimeElement>('[data-clock-time]')!;
    const hour = clock.querySelector('.clock-hour')!;
    const minute = clock.querySelector('.clock-minute')!;
    const second = clock.querySelector('.clock-second')!;

    const zone = 'Australia/Brisbane';
    const label = new Intl.DateTimeFormat('en-AU', {
      timeZone: zone,
      hour: 'numeric',
      minute: '2-digit',
      hour12: true,
    });
    const parts = new Intl.DateTimeFormat('en-AU', {
      timeZone: zone,
      hour: 'numeric',
      minute: 'numeric',
      second: 'numeric',
      hourCycle: 'h23',
    });

    const tick = () => {
      const now = new Date();
      const get = (type: string) =>
        Number(parts.formatToParts(now).find((p) => p.type === type)?.value ?? 0);
      const h = get('hour') % 12;
      const m = get('minute');
      const s = get('second');

      hour.setAttribute('transform', `rotate(${(h + m / 60) * 30} 14 14)`);
      minute.setAttribute('transform', `rotate(${(m + s / 60) * 6} 14 14)`);
      second.setAttribute('transform', `rotate(${s * 6} 14 14)`);
      timeEl.textContent = label.format(now);
      timeEl.dateTime = now.toISOString();

      // Wake on the next whole second so the hand ticks in time with real clocks.
      window.setTimeout(tick, 1000 - (now.getTime() % 1000));
    };

    tick();
    clock.hidden = false;
  }
</script>
