---
/**
 * Screenshots in a device frame: `phone` for apps, `browser` for web apps.
 * When the row is wide enough for all the phones (desktop),
 * they sit side by side. When it isn't (phones), it becomes a swipeable row:
 * swiping and keyboard scrolling are pure CSS scroll snap, and a small script
 * adds arrow buttons and a "1 / 3" counter, shown only when there is
 * something to scroll to.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { meta } from '../lib/meta';

interface Props {
  screens: { src: ImageMetadata; caption: string; alt: string }[];
  label: string;
  frame?: 'phone' | 'browser';
}

const { screens, label, frame = 'phone' } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
---

<div class={`carousel carousel--${frame}`} data-carousel>
  <div class="track" tabindex="0" role="region" aria-roledescription="carousel" aria-label={label}>
    {
      screens.map((screen, i) => (
        <figure class="slide" aria-label={`${i + 1} of ${screens.length}`}>
          {frame === 'phone' ? (
            <div class="phone">
              <Image
                src={screen.src}
                alt={screen.alt}
                widths={[280, 560, 840]}
                sizes="280px"
                loading={i === 0 ? 'eager' : 'lazy'}
                class="screen"
              />
            </div>
          ) : (
            <div class="browser">
              <span class="bar" aria-hidden="true">
                <i />
                <i />
                <i />
              </span>
              <Image
                src={screen.src}
                alt={screen.alt}
                widths={[600, 1200, 1800]}
                sizes="(max-width: 640px) 85vw, 600px"
                loading={i === 0 ? 'eager' : 'lazy'}
                class="screen"
              />
            </div>
          )}
          <figcaption>{meta([pad(i + 1), screen.caption])}</figcaption>
        </figure>
      ))
    }
  </div>

  {
    screens.length > 1 && (
      <div class="controls" data-controls hidden>
        <button type="button" class="nav" data-prev aria-label="Previous screen" disabled>
          <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
            <path d="M10 3L5 8l5 5" />
          </svg>
        </button>
        <span class="count" data-count aria-live="polite">
          1 / {screens.length}
        </span>
        <button type="button" class="nav" data-next aria-label="Next screen">
          <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
            <path d="M6 3l5 5-5 5" />
          </svg>
        </button>
      </div>
    )
  }
</div>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((carousel) => {
    const track = carousel.querySelector<HTMLElement>('.track')!;
    const slides = [...track.querySelectorAll<HTMLElement>('.slide')];
    const controls = carousel.querySelector<HTMLElement>('[data-controls]');
    if (!controls || slides.length < 2) return;

    const prev = controls.querySelector<HTMLButtonElement>('[data-prev]')!;
    const next = controls.querySelector<HTMLButtonElement>('[data-next]')!;
    const count = controls.querySelector<HTMLElement>('[data-count]')!;

    const step = () => slides[1].offsetLeft - slides[0].offsetLeft;
    const go = (dir: number) =>
      track.scrollBy({ left: dir * step(), behavior: reduceMotion.matches ? 'auto' : 'smooth' });

    let frame = 0;
    const update = () => {
      frame = 0;
      const max = track.scrollWidth - track.clientWidth;
      controls.hidden = max <= 2;
      const atEnd = track.scrollLeft >= max - 2;
      const index = atEnd ? slides.length - 1 : Math.round(track.scrollLeft / step());
      count.textContent = `${index + 1} / ${slides.length}`;
      prev.disabled = track.scrollLeft <= 2;
      next.disabled = atEnd;
    };

    prev.addEventListener('click', () => go(-1));
    next.addEventListener('click', () => go(1));
    track.addEventListener('scroll', () => {
      if (!frame) frame = requestAnimationFrame(update);
    });
    window.addEventListener('resize', update);

    update();
  });
</script>

<style>
  .carousel {
    --phone-w: 240px;
    --track-pad: calc(50% - var(--phone-w) / 2 - 8px);

    container-type: inline-size;
    border-radius: 8px;
    background: var(--visual);
  }

  /* Horizontal scroller. Snap points land each phone at the track's start
     edge on wide screens and in the centre on phones. */
  .track {
    display: flex;
    gap: var(--s-5);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--track-pad);
    padding: var(--s-6) var(--track-pad) var(--s-5);
    scrollbar-width: none;
    border-radius: 8px;
  }

  .track::-webkit-scrollbar {
    display: none;
  }

  .track:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }

  .slide {
    flex: none;
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--s-3);
    scroll-snap-align: center;
  }

  /* The same device frame as the homepage card. */
  .phone {
    width: var(--phone-w);
    box-sizing: content-box;
    border: 6px solid var(--device);
    border-radius: 28px;
    overflow: hidden;
    background: var(--device);
    filter: drop-shadow(0 14px 12px var(--shadow));
  }

  .phone :global(.screen),
  .browser :global(.screen) {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Web app screenshots: a quiet window with a title bar, wider slides. */
  .carousel--browser {
    --track-pad: 7.5%;
  }

  .carousel--browser .slide {
    width: min(600px, 85cqi);
  }

  .browser {
    width: 100%;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--paper);
    box-shadow: 0 14px 32px var(--shadow);
  }

  .bar {
    display: flex;
    gap: 6px;
    padding: 10px var(--s-3);
    border-bottom: 1px solid var(--line);
  }

  .bar i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--line);
  }

  .slide figcaption,
  .count {
    font: 400 var(--t-label) / 1.6 var(--mono);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .controls {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: var(--s-4);
    padding-bottom: var(--s-4);
  }

  .controls[hidden] {
    display: none;
  }

  .nav {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transition:
      background-color 120ms ease,
      color 120ms ease;
  }

  .nav svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .nav:hover:not(:disabled) {
    background: var(--accent-tint);
  }

  .nav:active:not(:disabled) {
    color: var(--accent);
  }

  .nav:disabled {
    color: var(--subtle);
    opacity: 0.4;
    cursor: default;
  }

  .count {
    min-width: 5ch;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }

  /* Wide enough for all three: side by side, nothing hidden, no controls.
     (Default above is the phone layout: one screen centred, the next
     peeking in from the right.) */
  @container (min-width: 680px) {
    .carousel--phone .track {
      justify-content: center;
      overflow: visible;
      padding: var(--s-7) var(--s-5) var(--s-6);
    }

    .carousel--phone .slide {
      flex: 0 1 260px;
      min-width: 0;
    }

    .carousel--phone .phone {
      width: calc(100% - 12px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav {
      transition: none;
    }
  }
</style>
