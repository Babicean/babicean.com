---
import { site } from '../site';

interface Props {
  /** '' on the homepage (links scroll), '/' elsewhere (links go home first). */
  base?: string;
}

const { base = '' } = Astro.props;
const nav = [
  { label: 'Work', id: 'work' },
  { label: 'About', id: 'about' },
  { label: 'Reading', id: 'reading' },
  { label: 'Contact', id: 'contact' },
];
---

<header class="site-header wrap">
  <a class="brand" href="/" aria-label={`${site.name}, home`}>
    <span class="monogram" aria-hidden="true">bb<span>.</span></span>
    <span>{site.name}</span>
  </a>
  <nav class="nav-links" aria-label="Main">
    {nav.map((item) => <a href={`${base}#${item.id}`}>{item.label}</a>)}
  </nav>
  <button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch to dark theme" hidden>
    <svg width="18" height="18" viewBox="0 0 20 20" aria-hidden="true">
      <circle cx="10" cy="10" r="7.25" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
      <path d="M10 2.75a7.25 7.25 0 0 1 0 14.5z" fill="currentColor"></path>
    </svg>
  </button>
</header>
